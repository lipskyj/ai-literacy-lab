{
  "name": "SiteContent",
  "type": "object",
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "resource",
        "topic",
        "experiment_idea"
      ],
      "description": "Type of content"
    },
    "title": {
      "type": "string",
      "description": "Title of the content"
    },
    "subtitle": {
      "type": "string",
      "description": "Subtitle (for resources)"
    },
    "description": {
      "type": "string",
      "description": "Description text"
    },
    "link": {
      "type": "string",
      "description": "External link (for resources)"
    },
    "icon": {
      "type": "string",
      "description": "Icon name (for experiment ideas)"
    },
    "category": {
      "type": "string",
      "description": "Category for topics"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether content is visible"
    }
  },
  "required": [
    "content_type",
    "title",
    "description"
  ]
}